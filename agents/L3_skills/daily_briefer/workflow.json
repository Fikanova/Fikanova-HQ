{
    "name": "L3 - Skill: Daily Briefer",
    "description": "Generates daily morning briefings with key metrics, tasks, and priorities",
    "nodes": [
        {
            "parameters": {
                "inputSource": "passthrough"
            },
            "name": "Briefer Input",
            "type": "n8n-nodes-base.executeWorkflowTrigger",
            "typeVersion": 1,
            "position": [
                100,
                300
            ],
            "id": "briefer-input"
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{ $env.APPWRITE_ENDPOINT }}/databases/{{ $env.APPWRITE_DATABASE_ID }}/collections/Communications/documents",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-Appwrite-Project",
                            "value": "={{ $env.APPWRITE_PROJECT_ID }}"
                        },
                        {
                            "name": "X-Appwrite-Key",
                            "value": "={{ $env.APPWRITE_API_KEY }}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Get Recent Comms",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                300,
                200
            ],
            "id": "briefer-comms"
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{ $env.APPWRITE_ENDPOINT }}/databases/{{ $env.APPWRITE_DATABASE_ID }}/collections/Expenses/documents",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-Appwrite-Project",
                            "value": "={{ $env.APPWRITE_PROJECT_ID }}"
                        },
                        {
                            "name": "X-Appwrite-Key",
                            "value": "={{ $env.APPWRITE_API_KEY }}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Get Recent Expenses",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                300,
                400
            ],
            "id": "briefer-expenses"
        },
        {
            "parameters": {
                "jsCode": "const comms = items[0]?.json?.documents || [];\nconst expenses = items[1]?.json?.documents || [];\n\nconst today = new Date();\nconst dayName = today.toLocaleDateString('en-KE', { weekday: 'long' });\nconst dateStr = today.toLocaleDateString('en-KE', { day: 'numeric', month: 'long', year: 'numeric' });\n\nconst totalExpenses = expenses.reduce((sum, e) => sum + (e.amount || 0), 0);\nconst pendingComms = comms.filter(c => c.status === 'pending').length;\n\nconst brief = `\n☀️ **Good morning!**\n📅 ${dayName}, ${dateStr}\n\n---\n\n📊 **Quick Stats:**\n• Pending messages: ${pendingComms}\n• Recent expenses: KES ${totalExpenses.toLocaleString()}\n• Active agents: All operational ✅\n\n🎯 **Today's Priorities:**\n1. Review pending communications\n2. Check financial runway\n3. Monitor agent performance\n\n💡 **Tip of the day:** Focus on high-impact tasks first.\n\n---\n*Generated by Fikanova CIO Agent*\n`;\n\nreturn [{ json: { brief, pendingComms, totalExpenses, date: dateStr } }];"
            },
            "name": "Generate Brief",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                500,
                300
            ],
            "id": "briefer-generate"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.APPWRITE_ENDPOINT }}/databases/{{ $env.APPWRITE_DATABASE_ID }}/collections/Daily_Briefs/documents",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-Appwrite-Project",
                            "value": "={{ $env.APPWRITE_PROJECT_ID }}"
                        },
                        {
                            "name": "X-Appwrite-Key",
                            "value": "={{ $env.APPWRITE_API_KEY }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"documentId\": \"unique()\",\n  \"data\": {\n    \"date\": \"{{ new Date().toISOString().split('T')[0] }}\",\n    \"summary\": \"{{ $json.brief.substring(0, 1900) }}\",\n    \"priority_items\": \"Pending comms: {{ $json.pendingComms }}, Expenses: {{ $json.totalExpenses }}\",\n    \"sent_at\": \"{{ new Date().toISOString() }}\"\n  }\n}",
                "options": {}
            },
            "name": "Save Brief",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                700,
                300
            ],
            "id": "briefer-save"
        },
        {
            "parameters": {
                "jsCode": "return [{ json: { success: true, message: 'Daily brief generated', brief: items[0].json.brief } }];"
            },
            "name": "Briefer Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                900,
                300
            ],
            "id": "briefer-response"
        }
    ],
    "connections": {
        "Briefer Input": {
            "main": [
                [
                    {
                        "node": "Get Recent Comms",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Get Recent Expenses",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Recent Comms": {
            "main": [
                [
                    {
                        "node": "Generate Brief",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Recent Expenses": {
            "main": [
                [
                    {
                        "node": "Generate Brief",
                        "type": "main",
                        "index": 1
                    }
                ]
            ]
        },
        "Generate Brief": {
            "main": [
                [
                    {
                        "node": "Save Brief",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Save Brief": {
            "main": [
                [
                    {
                        "node": "Briefer Response",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}