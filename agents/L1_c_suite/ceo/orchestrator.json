{
    "name": "L1 - CEO Agent",
    "description": "Central command router for Human-Centric C-Suite. Routes WhatsApp commands to appropriate executives and sends responses back via WhatsApp.",
    "nodes": [
        {
            "id": "ceo-webhook",
            "parameters": {
                "httpMethod": "POST",
                "path": "ceo-command",
                "responseMode": "lastNode",
                "options": {}
            },
            "name": "WhatsApp Bridge Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                100,
                300
            ]
        },
        {
            "id": "ceo-save-context",
            "parameters": {
                "mode": "raw",
                "jsonOutput": "={{ JSON.stringify({ original_message: $json.message, from_phone: $json.from_phone, communication_id: $json.communication_id, target_agent: $json.target_agent }) }}"
            },
            "name": "Save Context",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                250,
                300
            ]
        },
        {
            "id": "ceo-classify",
            "parameters": {
                "prompt": "You are the CEO orchestrator for Fikanova. Analyze this command and determine which C-Suite executive should handle it.\n\nCommand: {{ $json.original_message }}\nFrom: {{ $json.from_phone }}\n\nRespond with ONLY ONE of these exact words: Finance, Product, Marketing, Operations, Governance\n\n- Finance = CFO (money, runway, expenses, tax, KRA, invoice, payment, mpesa)\n- Product = CTO (tech, code, deploy, systems, api, bug, feature)\n- Marketing = CMO (content, social, newsletter, branding, drafts, post)\n- Operations = CIO (data, knowledge, daily briefs, status, report)\n- Governance = CimpO (ESG, compliance, audits, metrics, learning)\n\nIf unclear, respond with: Operations"
            },
            "name": "CEO Intent Classifier",
            "type": "@n8n/n8n-nodes-langchain.chainLlm",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "id": "ceo-gemini-model",
            "parameters": {
                "model": "models/gemini-2.0-flash",
                "options": {
                    "temperature": 0.1
                }
            },
            "name": "Google Gemini Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                450,
                500
            ],
            "credentials": {
                "googleGeminiApi": {
                    "id": "gemini-creds",
                    "name": "Google Gemini API"
                }
            }
        },
        {
            "id": "ceo-parse",
            "parameters": {
                "jsCode": "const text = items[0].json.text || items[0].json.response || 'Operations';\nconst classification = text.trim().toLowerCase();\nlet route = 'operations';\nif (classification.includes('finance')) route = 'finance';\nelse if (classification.includes('product')) route = 'product';\nelse if (classification.includes('marketing')) route = 'marketing';\nelse if (classification.includes('governance')) route = 'governance';\nelse if (classification.includes('operations')) route = 'operations';\nitems[0].json.route = route;\nitems[0].json.agent_name = { 'finance': 'CFO', 'product': 'CTO', 'marketing': 'CMO', 'operations': 'CIO', 'governance': 'CimpO' }[route];\nreturn items;"
            },
            "name": "Parse Classification",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                650,
                300
            ]
        },
        {
            "id": "ceo-router",
            "parameters": {
                "rules": {
                    "values": [
                        {
                            "conditions": {
                                "options": {
                                    "caseSensitive": false
                                },
                                "conditions": [
                                    {
                                        "leftValue": "={{$json.route}}",
                                        "rightValue": "finance",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ],
                                "combinator": "and"
                            },
                            "renameOutput": true,
                            "outputKey": "To_CFO"
                        },
                        {
                            "conditions": {
                                "options": {
                                    "caseSensitive": false
                                },
                                "conditions": [
                                    {
                                        "leftValue": "={{$json.route}}",
                                        "rightValue": "product",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ],
                                "combinator": "and"
                            },
                            "renameOutput": true,
                            "outputKey": "To_CTO"
                        },
                        {
                            "conditions": {
                                "options": {
                                    "caseSensitive": false
                                },
                                "conditions": [
                                    {
                                        "leftValue": "={{$json.route}}",
                                        "rightValue": "marketing",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ],
                                "combinator": "and"
                            },
                            "renameOutput": true,
                            "outputKey": "To_CMO"
                        },
                        {
                            "conditions": {
                                "options": {
                                    "caseSensitive": false
                                },
                                "conditions": [
                                    {
                                        "leftValue": "={{$json.route}}",
                                        "rightValue": "operations",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ],
                                "combinator": "and"
                            },
                            "renameOutput": true,
                            "outputKey": "To_CIO"
                        },
                        {
                            "conditions": {
                                "options": {
                                    "caseSensitive": false
                                },
                                "conditions": [
                                    {
                                        "leftValue": "={{$json.route}}",
                                        "rightValue": "governance",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ],
                                "combinator": "and"
                            },
                            "renameOutput": true,
                            "outputKey": "To_CimpO"
                        }
                    ]
                },
                "fallbackOutput": "Fallback"
            },
            "name": "C-Suite Router",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 3,
            "position": [
                850,
                300
            ]
        },
        {
            "id": "ceo-cfo-response",
            "parameters": {
                "jsCode": "items[0].json.response_message = `📊 CFO received your request: \"${items[0].json.original_message}\"\\n\\nProcessing financial analysis...`;\nitems[0].json.agent_source = 'CFO';\nreturn items;"
            },
            "name": "CFO Quick Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                100
            ]
        },
        {
            "id": "ceo-cto-response",
            "parameters": {
                "jsCode": "items[0].json.response_message = `💻 CTO received your request: \"${items[0].json.original_message}\"\\n\\nAnalyzing technical requirements...`;\nitems[0].json.agent_source = 'CTO';\nreturn items;"
            },
            "name": "CTO Quick Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                200
            ]
        },
        {
            "id": "ceo-cmo-response",
            "parameters": {
                "jsCode": "items[0].json.response_message = `📣 CMO received your request: \"${items[0].json.original_message}\"\\n\\nPreparing marketing strategy...`;\nitems[0].json.agent_source = 'CMO';\nreturn items;"
            },
            "name": "CMO Quick Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                300
            ]
        },
        {
            "id": "ceo-cio-response",
            "parameters": {
                "jsCode": "items[0].json.response_message = `📋 CIO received your request: \"${items[0].json.original_message}\"\\n\\nGathering operational data...`;\nitems[0].json.agent_source = 'CIO';\nreturn items;"
            },
            "name": "CIO Quick Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                400
            ]
        },
        {
            "id": "ceo-cimpo-response",
            "parameters": {
                "jsCode": "items[0].json.response_message = `🔍 CimpO received your request: \"${items[0].json.original_message}\"\\n\\nReviewing compliance and governance...`;\nitems[0].json.agent_source = 'CimpO';\nreturn items;"
            },
            "name": "CimpO Quick Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                500
            ]
        },
        {
            "id": "ceo-fallback-response",
            "parameters": {
                "jsCode": "items[0].json.response_message = `👋 CEO here. I received your message: \"${items[0].json.original_message}\"\\n\\nI'll handle this personally.`;\nitems[0].json.agent_source = 'CEO';\nreturn items;"
            },
            "name": "CEO Fallback Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1050,
                600
            ]
        },
        {
            "id": "ceo-merge",
            "parameters": {
                "mode": "passThrough"
            },
            "name": "Merge Responses",
            "type": "n8n-nodes-base.merge",
            "typeVersion": 3,
            "position": [
                1250,
                300
            ]
        },
        {
            "id": "ceo-send-whatsapp",
            "parameters": {
                "method": "POST",
                "url": "https://fra.cloud.appwrite.io/v1/functions/6948e3830020bb54a6a8/executions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-Appwrite-Project",
                            "value": "6936df5800371a655e8e"
                        },
                        {
                            "name": "X-Appwrite-Key",
                            "value": "standard_b65b18940e0f3bcf8ec0d3f6113e98c227ba525d695bf60cd83462c9b8258ccac60dbff36f5bc100ce6ee7b66a397f898892183145f303067dad2b137155c11026a67225111071f3527c417a21eb626ef95f6a4ef9aac11db4fd9c9d90b77380237533f7f9fcbab17924754357f81874e0deb307b61f55ac642aeef7dae2f3da"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ body: JSON.stringify({ direction: 'outbound', message: $json.response_message, agent_source: $json.agent_source, to_phone: $json.from_phone }) }) }}",
                "options": {}
            },
            "name": "Send WhatsApp Response",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1450,
                300
            ]
        },
        {
            "id": "ceo-update-comms",
            "parameters": {
                "method": "PATCH",
                "url": "=https://fra.cloud.appwrite.io/v1/databases/693703ef001133c62d78/collections/Communications/documents/{{ $json.communication_id }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-Appwrite-Project",
                            "value": "6936df5800371a655e8e"
                        },
                        {
                            "name": "X-Appwrite-Key",
                            "value": "standard_b65b18940e0f3bcf8ec0d3f6113e98c227ba525d695bf60cd83462c9b8258ccac60dbff36f5bc100ce6ee7b66a397f898892183145f303067dad2b137155c11026a67225111071f3527c417a21eb626ef95f6a4ef9aac11db4fd9c9d90b77380237533f7f9fcbab17924754357f81874e0deb307b61f55ac642aeef7dae2f3da"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{ \"data\": { \"status\": \"responded\" } }",
                "options": {}
            },
            "name": "Update Communications Status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1650,
                300
            ]
        }
    ],
